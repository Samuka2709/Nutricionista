---
// Abertura: título em serifa com ênfase em itálico, duas ações e o retrato em arco.
import { p, t, nome, crn, identificacao, modalidadesTexto, presencial, online, agendarUrl, secoes, tem, enfase } from '../lib/site';
import Foto from './Foto.astro';
import Icone from './Icone.astro';
import Preencher from './Preencher.astro';

const destino = secoes.sobre ? '#sobre' : secoes.especialidades ? '#especialidades' : '#metodologia';
---
<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="fundo-areia" aria-hidden="true"></div>
  <div class="grade caixa-l" data-hero>
    <div class="texto">
      <h1 id="hero-titulo" data-entrada data-titulo-hero set:html={enfase(t.hero.titulo)} />
      <p class="descricao" data-entrada>{t.hero.descricao}</p>
      <div class="acoes b-cta" data-entrada>
        {agendarUrl ? (
          <a class="botao botao--acao evento" href={agendarUrl} target="_blank" rel="noopener noreferrer" data-agendar>
            Agendar consulta<span class="so-leitor"> (abre em nova aba)</span>
          </a>
        ) : <Preencher campo="whatsapp ou linkAgendamento" />}
        <a class="botao botao--linha" href={destino}>Conhecer meu trabalho</a>
      </div>
    </div>

    <figure class="arte">
      <div class="moldura" aria-hidden="true"></div>
      <div class="arco b-foto" data-foto-hero>
        <Foto arquivo={p.fotos?.retrato} tipo="retrato profissional" alt={p.fotos?.descricaoRetrato || (nome ? `${nome}, nutricionista` : 'Nutricionista')} preenche prioridade sizes="(min-width: 1024px) 40vw, 90vw" />
      </div>
      {modalidadesTexto && <span class="selo-mod" data-entrada><Icone nome="video" tamanho={16} />{presencial && online ? 'Presencial e online' : presencial ? 'Atendimento presencial' : 'Atendimento online'}</span>}
      <figcaption class="cartao-nome b-legenda" data-entrada>
        <span class="icone"><Icone nome="registro" tamanho={20} /></span>
        <span><strong>{nome}</strong><small>{identificacao}</small></span>
      </figcaption>
      {tem(p.fotos?.credito) && <p class="credito">{p.fotos.credito}</p>}
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; padding-top: calc(var(--header-h) + 24px); padding-bottom: clamp(56px, 8vw, 104px); overflow: hidden; }
  .fundo-areia {
    position: absolute; z-index: -1; top: var(--header-h); right: 0; width: 44%; bottom: 0; border-top-left-radius: var(--raio);
    background: var(--oliva);
  }
  .grade { display: grid; gap: 56px; align-items: center; }

  .texto { display: grid; gap: 22px; justify-items: start; }
  h1 { max-width: 17ch; }
  .descricao { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); color: var(--texto-suave); max-width: 40ch; }
  .acoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }

  .arte { position: relative; margin: 0 auto; width: min(100%, 440px); padding: 22px 22px 0 0; }
  .moldura { position: absolute; top: 0; right: 0; bottom: 58px; left: 22px; border: 1px solid var(--cobre-claro); border-radius: var(--raio); opacity: 0.8; }
  .arco {
    position: relative; aspect-ratio: 4 / 5; overflow: hidden;
    border-radius: var(--raio); background: var(--salvia);
    box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.65);
  }
  .arco :global(.foto) { border-radius: 0; }
  .arco::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(to top, rgb(18 34 44 / 0.28), transparent 38%); }
  .selo-mod {
    position: absolute; top: 46px; left: -22px; display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 14px; border-radius: 8px; background: var(--branco); color: var(--oliva);
    font-size: 0.78rem; font-weight: 650; box-shadow: var(--sombra);
  }
  .selo-mod :global(svg) { color: var(--terra); }
  .cartao-nome {
    position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; width: calc(100% - 44px);
    margin: -44px 0 0 -22px; padding: 16px 20px 16px 16px; border-radius: 10px; background: var(--branco);
    box-shadow: 0 24px 50px -28px rgb(0 0 0 / 0.55);
  }
  .cartao-nome .icone { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 8px; background: var(--oliva); color: var(--cobre-claro); }
  .cartao-nome strong { display: block; font-family: var(--serif); font-weight: 600; font-size: 1.15rem; color: var(--oliva); line-height: 1.2; }
  .cartao-nome small { display: block; font-size: 0.78rem; color: var(--texto-suave); }
  .credito { margin-top: 14px; font-size: 0.72rem; line-height: 1.4; color: var(--sobre-oliva); max-width: none; }

  @media (max-width: 1023px) { .fundo-areia { top: auto; bottom: 0; width: 100%; height: 52%; } .arte { width: min(100% - 24px, 440px); } }
  @media (min-width: 1024px) {
    .hero { padding-top: calc(var(--header-h) + 40px); min-height: min(calc(100svh - var(--aviso-h)), 900px); display: flex; align-items: center; }
    .grade { grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: clamp(48px, 6vw, 96px); }
    .arte { margin-right: 0; }
  }
  @media (max-width: 480px) { .acoes { width: 100%; } .acoes :global(.botao) { flex: 1 1 100%; } }
</style>
