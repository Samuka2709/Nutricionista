---
// Contato: cada canal só aparece se informado. Formulário sem nenhum campo de saúde (LGPD).
import { p, t, whatsappUrl, whatsappExibicao, instagramUrl, instagramExibicao, enderecoTexto, temEndereco, formEndpoint, secoes, tem, demo, enfase } from '../lib/site';
import Icone from './Icone.astro';
import Preencher from './Preencher.astro';
const horarios = (p.horarios || []).filter((h: any) => tem(h.dias));
const simulado = formEndpoint === 'demo';
---
{!secoes.contato ? <Preencher bloco campo="whatsapp, email, instagram, endereco, formulario.endpoint" /> : (
  <section class="secao contato" id="contato" aria-labelledby="contato-titulo">
    <div class="caixa-l grade">
      <div class="info">
        <h2 id="contato-titulo" data-titulo set:html={enfase(t.contato.titulo)} />
        <ul class="canais">
          {whatsappUrl && <li><span class="ic"><Icone nome="conversa" tamanho={18} /></span><div><strong>WhatsApp</strong><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{whatsappExibicao}<span class="so-leitor"> (abre em nova aba)</span></a></div></li>}
          {tem(p.email) && <li><span class="ic"><Icone nome="email" tamanho={18} /></span><div><strong>E-mail</strong><a href={`mailto:${p.email}`}>{p.email}</a></div></li>}
          {instagramUrl && <li><span class="ic"><Icone nome="arroba" tamanho={18} /></span><div><strong>Instagram</strong><a href={instagramUrl} target="_blank" rel="noopener noreferrer">{instagramExibicao}<span class="so-leitor"> (abre em nova aba)</span></a></div></li>}
          {temEndereco && <li><span class="ic"><Icone nome="mapa" tamanho={18} /></span><div><strong>Endereço</strong><span>{enderecoTexto}</span></div></li>}
          {horarios.length > 0 && <li><span class="ic"><Icone nome="relogio" tamanho={18} /></span><div><strong>Horários</strong><span>{horarios.map((h: any) => `${h.dias}, ${h.horas}`).join(' · ')}</span></div></li>}
        </ul>
      </div>

      <div class="cartao-suave caixa-form">
        {tem(formEndpoint) ? (
          <form class="form" action={simulado ? '#contato' : formEndpoint} method="post" novalidate data-form data-simulado={simulado ? '' : undefined}>
            <h3>Envie uma mensagem</h3>
            <div class="duplo">
              <div class="campo">
                <label for="f-nome">Nome</label>
                <input id="f-nome" name="nome" type="text" autocomplete="name" required aria-describedby="e-nome" />
                <p class="erro" id="e-nome" data-erro="nome"></p>
              </div>
              <div class="campo">
                <label for="f-email">E-mail</label>
                <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="e-email" />
                <p class="erro" id="e-email" data-erro="email"></p>
              </div>
            </div>
            <div class="campo">
              <label for="f-telefone">Telefone <span class="opcional">(opcional)</span></label>
              <input id="f-telefone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="e-telefone" />
              <p class="erro" id="e-telefone" data-erro="telefone"></p>
            </div>
            <div class="campo">
              <label for="f-mensagem">Mensagem</label>
              <textarea id="f-mensagem" name="mensagem" rows="4" required aria-describedby="e-mensagem aviso-saude"></textarea>
              <p class="erro" id="e-mensagem" data-erro="mensagem"></p>
            </div>
            <p class="mel" aria-hidden="true">
              <label for="f-site">Não preencha este campo</label>
              <input id="f-site" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
            </p>
            <p class="aviso-saude pequeno" id="aviso-saude">{t.contato.avisoSaude}</p>
            <div class="campo aceite">
              <label class="check" for="f-aceite">
                <input id="f-aceite" name="consentimento" type="checkbox" value="sim" required aria-describedby="e-consentimento" />
                <span>Li e concordo com a <a href="/privacidade">Política de Privacidade</a>.</span>
              </label>
              <p class="erro" id="e-consentimento" data-erro="consentimento"></p>
            </div>
            <div class="envio">
              <button class="botao botao--acao" type="submit" data-enviar>Enviar mensagem</button>
              <p class="estado" role="status" aria-live="polite" data-estado></p>
            </div>
            {simulado && demo && <p class="pequeno simulado">Demonstração: o envio é simulado e nenhum dado sai do seu navegador.</p>}
          </form>
        ) : <Preencher campo="formulario.endpoint" nota="(Formspree, Netlify Forms ou similar); sem ele o formulário fica oculto" />}
      </div>
    </div>
  </section>
)}

<style>
  .grade { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 1024px) { .grade { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(48px, 6vw, 96px); } }
  .info { display: grid; gap: 28px; }
  .canais { display: grid; gap: 18px; }
  .canais li { display: flex; gap: 14px; align-items: flex-start; }
  .ic { flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: var(--branco); color: var(--salvia); border: 1px solid var(--linha); }
  .canais div { display: grid; gap: 1px; min-width: 0; }
  .canais strong { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--salvia); }
  .canais a, .canais span { color: var(--carvao); overflow-wrap: anywhere; font-size: 0.98rem; }
  .canais a { text-decoration: none; }
  @media (hover: hover) { .canais a:hover { text-decoration: underline; } }

  .caixa-form { padding: clamp(24px, 4vw, 44px); }
  .form { display: grid; gap: 18px; }
  .form h3 { font-family: var(--serif); font-weight: 560; font-size: 1.6rem; }
  .duplo { display: grid; gap: 18px; }
  @media (min-width: 640px) { .duplo { grid-template-columns: 1fr 1fr; } }
  .campo { display: grid; gap: 6px; }
  label { font-size: 0.85rem; font-weight: 650; color: var(--oliva); }
  .opcional { font-weight: 400; color: var(--texto-suave); }
  input[type="text"], input[type="email"], input[type="tel"], textarea {
    width: 100%; min-height: 50px; padding: 12px 16px;
    background: var(--creme); border: 1px solid var(--linha-forte); border-radius: 8px;
    font-size: 1rem; line-height: 1.5; color: var(--carvao); transition: border-color 160ms ease, background-color 160ms ease;
  }
  textarea { resize: vertical; min-height: 120px; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--salvia); outline-offset: 2px; border-color: var(--salvia); background: var(--branco); }
  :is(input, textarea)[aria-invalid="true"] { border-color: var(--erro); }
  .erro { font-size: 0.85rem; font-weight: 600; line-height: 1.4; color: var(--erro); }
  .erro:empty { display: none; }
  .mel { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .check { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 12px; align-items: start; min-height: 44px; padding-block: 6px; font-weight: 400; font-size: 0.9rem; color: var(--carvao); cursor: pointer; }
  .check input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--salvia); }
  .aviso-saude { padding: 12px 14px; border-radius: 12px; background: var(--salvia-clara); color: var(--oliva); max-width: none; }
  .envio { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .estado { font-weight: 600; max-width: none; }
  .estado:empty { display: none; }
  :global(.estado.ok) { color: var(--salvia-fundo); }
  :global(.estado.falha) { color: var(--erro); }
  :global([data-enviar][disabled]) { opacity: 0.6; cursor: progress; }
  .simulado { color: var(--texto-suave); }
</style>
