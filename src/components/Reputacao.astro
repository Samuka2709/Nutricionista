---
// Avaliações públicas reais (com link de origem) ou, na falta delas, os princípios do atendimento.
// Nada de estrelas, notas calculadas ou textos editados. Avaliações que citam resultado corporal são descartadas em site.ts.
import { avaliacoes, t, enfase } from '../lib/site';
import Icone from './Icone.astro';
const itens = t.principios.itens || [];
---
{avaliacoes.length > 0 ? (
  <section class="secao" id="avaliacoes" aria-labelledby="rep-titulo">
    <div class="caixa-l">
      <div class="cabeca"><h2 id="rep-titulo" data-titulo set:html={enfase(t.reputacao.titulo)} /></div>
      <ul class="grade">
        {avaliacoes.map((a) => (
          <li class="cartao-suave depo">
            <span class="aspas" aria-hidden="true"><Icone nome="aspas" tamanho={22} /></span>
            <blockquote><p>{a.texto}</p></blockquote>
            <p class="autor">
              <strong>{a.nome}</strong>{a.data && <span>{a.data}</span>}
              <a class="link" href={a.url} target="_blank" rel="noopener noreferrer">Ver no {a.origem || 'Google'}<span class="so-leitor"> (abre em nova aba)</span></a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
) : itens.length > 0 && (
  <section class="secao" id="principios" aria-labelledby="rep-titulo">
    <div class="caixa-l">
      <div class="cabeca"><h2 id="rep-titulo" data-titulo>{t.principios.titulo}</h2></div>
      <ul class="grade">
        {itens.map((x: any) => (
          <li class="cartao-suave depo"><h3>{x.titulo}</h3><p>{x.texto}</p></li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .grade { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .depo { display: grid; gap: 18px; align-content: start; padding: 32px clamp(24px, 3vw, 36px); }
  .aspas { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: var(--salvia-clara); color: var(--terra); }
  blockquote p { font-family: var(--serif); font-size: 1.3rem; font-weight: 420; line-height: 1.45; color: var(--oliva); }
  .autor { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 0.85rem; color: var(--texto-suave); max-width: none; }
  .autor strong { color: var(--oliva); font-weight: 700; }
  .depo h3 { font-family: var(--serif); font-weight: 560; font-size: 1.4rem; }
  .depo p { color: var(--texto-suave); }
</style>
