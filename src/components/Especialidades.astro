---
// Cartões com foto e ícone, numa faixa de areia com bordas curvas. Detalhe em gaveta lateral.
import { especialidades, secoes, t, tem, enfase } from '../lib/site';
import Foto from './Foto.astro';
import BotaoAgendar from './BotaoAgendar.astro';
import Icone from './Icone.astro';
import Preencher from './Preencher.astro';
const icones = ['plano', 'atividade', 'semana', 'alvo', 'coracao', 'registro'];
---
{!secoes.especialidades ? <Preencher bloco campo="especialidades" /> : (
  <section class="secao secao--areia" id="especialidades" aria-labelledby="esp-titulo">
    <span class="curva curva--topo" aria-hidden="true"></span>
    <div class="caixa-l">
      <div class="cabeca cabeca--lado">
        <h2 id="esp-titulo" data-titulo set:html={enfase(t.especialidades.titulo)} />
        <p class="apoio">{t.especialidades.apoio}</p>
      </div>
      <ul class="cartoes" data-grupo>
        {especialidades.map((e, i) => (
          <li class="cartao-suave cartao" id={`esp-${e.id}`}>
            {e.imagem && (
              <div class="midia">
                <Foto arquivo={e.imagem} tipo={e.titulo} alt="" proporcao="16 / 10" larguras={[400, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
              </div>
            )}
            <div class="corpo">
              <span class="icone"><Icone nome={icones[i % icones.length]} tamanho={20} /></span>
              <h3>{e.titulo}</h3>
              {tem(e.descricao) && <p>{e.descricao}</p>}
              {tem(e.comoTrabalho) && (
                <a class="link" href={`#det-${e.id}`} data-abre-detalhe={`det-${e.id}`}>
                  Como eu trabalho<span class="so-leitor"> com {e.titulo.toLowerCase()}</span><Icone nome="seta" tamanho={16} />
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
    <span class="curva curva--base" aria-hidden="true"></span>

    {especialidades.filter((e) => tem(e.comoTrabalho)).map((e) => (
      <dialog class="gaveta" id={`det-${e.id}`} aria-labelledby={`det-t-${e.id}`} data-lenis-prevent>
        <div class="gaveta-in">
          <form method="dialog" class="fecha-form">
            <button class="fecha" type="submit"><Icone nome="fechar" /><span class="so-leitor">Fechar</span></button>
          </form>
          {e.imagem && <div class="gaveta-foto"><Foto arquivo={e.imagem} tipo={e.titulo} alt="" proporcao="16 / 9" larguras={[520, 1040]} sizes="520px" /></div>}
          <h3 id={`det-t-${e.id}`}>{e.titulo}</h3>
          {tem(e.descricao) && <p class="lead">{e.descricao}</p>}
          <h4>Como eu trabalho esse tema</h4>
          <p>{e.comoTrabalho}</p>
          <BotaoAgendar />
        </div>
      </dialog>
    ))}
  </section>
)}

<style>
  .cartoes { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .cartao { display: flex; flex-direction: column; overflow: hidden; transition: transform 320ms var(--ease-out), box-shadow 320ms var(--ease-out); }
  .midia { overflow: hidden; }
  .midia :global(.foto) { border-radius: 0; }
  .midia :global(img) { transition: scale 700ms var(--ease-out); }
  .corpo { position: relative; display: grid; gap: 10px; justify-items: start; padding: 34px 26px 28px; flex: 1; align-content: start; }
  .icone {
    position: absolute; top: -24px; left: 24px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 10px;
    background: var(--branco); color: var(--salvia); border: 1px solid var(--linha); box-shadow: var(--sombra);
  }
  .corpo p { font-size: 0.95rem; color: var(--texto-suave); }
  .corpo .link { margin-top: auto; padding-top: 6px; font-size: 0.9rem; }
  .cartao:not(:has(.midia)) .corpo { padding-top: 84px; }
  .cartao:not(:has(.midia)) .icone { top: 24px; }
  @media (hover: hover) and (pointer: fine) {
    .cartao:hover { transform: translateY(-4px); }
    .cartao:hover .midia :global(img) { scale: 1.05; }
  }

  .gaveta {
    position: fixed; inset: 0 0 0 auto; margin: 0; width: min(520px, 100vw); height: 100dvh; max-height: none; max-width: none;
    padding: 0; border: 0; background: var(--creme); color: var(--carvao);
    box-shadow: -24px 0 60px -30px color-mix(in srgb, var(--oliva) 45%, transparent);
    overflow-y: auto; transform: translateX(100%);
    transition: transform 260ms var(--ease-out), overlay 260ms allow-discrete, display 260ms allow-discrete;
    border-radius: 0;
  }
  .gaveta[open] { transform: none; transition-duration: 420ms; }
  @starting-style { .gaveta[open] { transform: translateX(100%); } }
  .gaveta::backdrop { background: color-mix(in srgb, var(--oliva) 40%, transparent); opacity: 0; transition: opacity 260ms ease, overlay 260ms allow-discrete, display 260ms allow-discrete; }
  .gaveta[open]::backdrop { opacity: 1; }
  @starting-style { .gaveta[open]::backdrop { opacity: 0; } }
  .gaveta-in { display: grid; gap: 16px; justify-items: start; padding: 18px 32px 40px; }
  .fecha-form { justify-self: end; }
  .fecha { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 8px; border: 1px solid var(--linha-forte); color: var(--oliva); }
  .gaveta-foto { width: 100%; }
  .gaveta h3 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.6rem); line-height: 1.1; }
  .gaveta h4 { margin: 8px 0 0; font-size: 0.95rem; font-weight: 700; color: var(--oliva); }
  .lead { color: var(--texto-suave); }
  .gaveta :global(.botao) { margin-top: 12px; }
  .gaveta:target:not([open]) { display: block; position: static; width: min(100% - 2 * var(--borda), 720px); height: auto; transform: none; box-shadow: none; margin: 32px auto 0; border-radius: var(--raio); }
  .gaveta:target:not([open]) .fecha-form { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .gaveta { transform: none; opacity: 0; transition: opacity 160ms ease, overlay 160ms allow-discrete, display 160ms allow-discrete; }
    .gaveta[open] { opacity: 1; }
    @starting-style { .gaveta[open] { transform: none; opacity: 0; } }
    .cartao, .midia :global(img) { transition: none; }
  }
</style>
