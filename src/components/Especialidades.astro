---
// Um destaque grande + lista com fios. Quantidade e conteúdo vêm do arquivo de dados.
import { especialidades, secoes, t, tem } from '../lib/site';
import Foto from './Foto.astro';
import PadraoSemana from './PadraoSemana.astro';
import BotaoAgendar from './BotaoAgendar.astro';
import Icone from './Icone.astro';
import Preencher from './Preencher.astro';
const [destaque, ...outras] = especialidades;
const rotuloLink = (titulo: string) => `Saiba como trabalho com ${titulo.toLowerCase()}`;
---
{!secoes.especialidades ? <Preencher bloco campo="especialidades" /> : (
  <section class="secao" id="especialidades" aria-labelledby="esp-titulo">
    <div class="fio" data-fio></div>
    <div class="sem cabeca">
      <div class="v" style="--i:1;--f:4">
        <h2 id="esp-titulo" data-titulo>{t.especialidades.titulo}</h2>
        <p class="apoio">{t.especialidades.apoio}</p>
      </div>
    </div>
    <div class="sem corpo">
      <article class="v destaque" style={`--i:1;--f:${outras.length ? 4 : 7}`} id={`esp-${destaque.id}`}>
        <div class="midia" data-revela>
          {destaque.imagem
            ? <Foto arquivo={destaque.imagem} tipo={destaque.titulo} alt={destaque.titulo} proporcao="4 / 3" parallax />
            : <PadraoSemana semente={0} proporcao="4 / 3" />}
        </div>
        <h3>{destaque.titulo}</h3>
        {tem(destaque.descricao) ? <p>{destaque.descricao}</p> : <Preencher campo="especialidades[0].descricao" />}
        {tem(destaque.comoTrabalho) && <a class="link" href={`#det-${destaque.id}`} data-abre-detalhe={`det-${destaque.id}`}>{rotuloLink(destaque.titulo)}</a>}
      </article>
      {outras.length > 0 && (
        <ul class="v lista" style="--i:5;--f:7">
          {outras.map((e, i) => (
            <li id={`esp-${e.id}`}>
              <div class="mini">
                {e.imagem
                  ? <Foto arquivo={e.imagem} tipo={e.titulo} alt="" proporcao="1 / 1" larguras={[160, 320]} sizes="88px" />
                  : <PadraoSemana semente={i + 1} proporcao="1 / 1" />}
              </div>
              <div class="txt">
                <h3>{e.titulo}</h3>
                {tem(e.descricao) && <p>{e.descricao}</p>}
                {tem(e.comoTrabalho) && <a class="link" href={`#det-${e.id}`} data-abre-detalhe={`det-${e.id}`}>{rotuloLink(e.titulo)}</a>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>

    {especialidades.filter((e) => tem(e.comoTrabalho)).map((e) => (
      <dialog class="gaveta" id={`det-${e.id}`} aria-labelledby={`det-t-${e.id}`} data-lenis-prevent>
        <div class="gaveta-in">
          <form method="dialog" class="fecha-form">
            <button class="fecha" type="submit"><Icone nome="fechar" /><span class="so-leitor">Fechar</span></button>
          </form>
          <h3 id={`det-t-${e.id}`}>{e.titulo}</h3>
          {tem(e.descricao) && <p class="lead">{e.descricao}</p>}
          <h4>Como eu trabalho esse tema</h4>
          <p>{e.comoTrabalho}</p>
          <BotaoAgendar />
        </div>
      </dialog>
    ))}
  </section>
)}

<style>
  .cabeca { margin-bottom: 40px; }
  .corpo { row-gap: 48px; }
  .midia { margin-bottom: 24px; overflow: hidden; border-radius: var(--raio-foto); }
  .destaque h3 { font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem); font-weight: 650; font-stretch: 90%; letter-spacing: -0.02em; line-height: 1.05; }
  .destaque p { margin-top: 12px; max-width: 48ch; }
  .destaque .link, .txt .link { margin-top: 14px; }
  .midia :global([data-parallax]), .mini :global(svg) { transition: transform 500ms var(--ease-out); }

  .lista { border-top: 1px solid var(--pauta-forte); align-self: start; }
  .lista li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 18px; padding-block: 22px; border-bottom: 1px solid var(--pauta-forte); scroll-margin-top: calc(var(--header-h) + 24px); }
  .mini { overflow: hidden; border-radius: var(--raio-foto); align-self: start; }
  .txt h3 { font-size: 1.3125rem; }
  .txt p { margin-top: 6px; font-size: var(--pequeno); line-height: 1.55; color: var(--texto-suave); }
  .txt .link { font-size: var(--pequeno); }

  @media (hover: hover) and (pointer: fine) {
    .destaque:hover .midia :global(svg), .destaque:hover .midia :global(img), .lista li:hover .mini :global(svg), .lista li:hover .mini :global(img) { transform: scale(1.03); }
  }
  @media (min-width: 1024px) {
    .cabeca { margin-bottom: 56px; }
    .lista li { grid-template-columns: 88px minmax(0, 1fr); }
  }

  /* Painel lateral de detalhe */
  .gaveta {
    position: fixed; inset: 0 0 0 auto; margin: 0; width: min(520px, 100vw); height: 100dvh; max-height: none; max-width: none;
    padding: 0; border: 0; background: var(--papel); color: var(--grafite);
    box-shadow: -24px 0 60px -30px color-mix(in srgb, var(--grafite) 45%, transparent);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 240ms var(--ease-out), overlay 240ms allow-discrete, display 240ms allow-discrete;
  }
  .gaveta[open] { transform: none; transition-duration: 380ms; }
  @starting-style { .gaveta[open] { transform: translateX(100%); } }
  .gaveta::backdrop { background: color-mix(in srgb, var(--grafite) 40%, transparent); opacity: 0; transition: opacity 240ms ease, overlay 240ms allow-discrete, display 240ms allow-discrete; }
  .gaveta[open]::backdrop { opacity: 1; }
  @starting-style { .gaveta[open]::backdrop { opacity: 0; } }
  .gaveta-in { display: grid; gap: 16px; justify-items: start; padding: 20px 28px 40px 32px; border-left: 1px solid var(--tinta); min-height: 100%; align-content: start; }
  .fecha-form { justify-self: end; }
  .fecha { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--raio-botao); color: var(--tinta); }
  .gaveta h3 { font-size: var(--h2); font-weight: 650; font-stretch: 90%; letter-spacing: -0.02em; line-height: 1.05; }
  .gaveta h4 { margin: 12px 0 0; font-size: 1rem; font-weight: 650; color: var(--tinta); }
  .lead { color: var(--texto-suave); }
  .gaveta :global(.botao) { margin-top: 12px; }
  /* Sem JavaScript: o link rola até o detalhe, que aparece no fluxo da página */
  .gaveta:target:not([open]) { display: block; position: static; width: auto; height: auto; transform: none; box-shadow: none; margin: 32px var(--borda) 0 calc(var(--calha) + var(--recuo)); }
  .gaveta:target:not([open]) .fecha-form { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .gaveta { transform: none; opacity: 0; transition: opacity 160ms ease, overlay 160ms allow-discrete, display 160ms allow-discrete; }
    .gaveta[open] { opacity: 1; }
    @starting-style { .gaveta[open] { transform: none; opacity: 0; } }
    .midia :global([data-parallax]), .mini :global(svg) { transition: none; }
  }
</style>
