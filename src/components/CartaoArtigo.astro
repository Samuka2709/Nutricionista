---
import { dataBR, slug } from '../lib/site';
import Foto from './Foto.astro';
import Icone from './Icone.astro';
interface Props { artigo: any; variante?: 'destaque' | 'linha' | 'grade'; semente?: number; nivel?: 'h2' | 'h3' }
const { artigo, nivel = 'h3' } = Astro.props;
const d = artigo.data;
const T = nivel;
---
<article class="cartao-suave cartao" data-categoria={slug(d.categoria)}>
  <a class="midia" href={`/conteudos/${artigo.id}`} tabindex="-1" aria-hidden="true">
    {d.imagem
      ? <Foto arquivo={d.imagem} tipo="imagem do artigo" alt="" proporcao="16 / 11" larguras={[400, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
      : <div class="sem-foto"><Icone nome="publicacao" tamanho={36} /></div>}
    <span class="cat">{d.categoria}</span>
  </a>
  <div class="txt">
    <T class="titulo"><a href={`/conteudos/${artigo.id}`}>{d.titulo}</a></T>
    {d.rascunho && <p><span class="rascunho">Rascunho: revisar antes de publicar</span></p>}
    <p class="meta"><time datetime={d.data.toISOString().slice(0, 10)}>{dataBR(d.data)}</time><span>{d.tempoLeitura} min de leitura</span></p>
  </div>
</article>

<style>
  .cartao { display: flex; flex-direction: column; overflow: hidden; min-width: 0; transition: transform 320ms var(--ease-out); }
  .midia { position: relative; display: block; overflow: hidden; }
  .midia :global(.foto) { border-radius: 0; }
  .midia :global(img) { transition: scale 700ms var(--ease-out); }
  .sem-foto { aspect-ratio: 16 / 11; display: grid; place-items: center; background: var(--salvia-clara); color: var(--salvia); }
  .cat {
    position: absolute; left: 16px; top: 16px; padding: 6px 12px; border-radius: 6px;
    background: color-mix(in srgb, var(--branco) 92%, transparent); color: var(--oliva); font-size: 0.75rem; font-weight: 700;
  }
  .txt { display: grid; gap: 10px; padding: 22px 24px 26px; align-content: start; }
  .titulo { font-family: var(--serif); font-weight: 560; font-size: 1.35rem; line-height: 1.22; }
  .titulo a { color: var(--oliva); text-decoration: none; }
  .titulo a::after { content: ''; position: absolute; inset: 0; }
  .cartao { position: relative; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 0.8rem; color: var(--texto-suave); }
  @media (hover: hover) and (pointer: fine) {
    .cartao:hover { transform: translateY(-4px); }
    .cartao:hover .midia :global(img) { scale: 1.05; }
  }
  @media (prefers-reduced-motion: reduce) { .cartao, .midia :global(img) { transition: none; } }
</style>
