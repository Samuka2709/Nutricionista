---
// Presencial e online lado a lado, em cartões com foto. O online só aparece se estiver nos dados
// (Resolução CFN nº 760/2023: exige cadastro no e-Nutricionista).
import { p, t, presencial, online, enderecoLinhas, temEndereco, cidadeCurta, secoes, tem, enfase } from '../lib/site';
import Foto from './Foto.astro';
import Icone from './Icone.astro';
import Mapa from './Mapa.astro';
import Preencher from './Preencher.astro';
const e = p.endereco || {};
const horarios = (p.horarios || []).filter((h: any) => tem(h.dias));
const fotoConsultorio = (p.fotos?.consultorio || []).find(tem);
const fotoOnline = (p.fotos?.atendimento || []).find(tem);
const o = t.atendimento.online;
---
{!secoes.atendimento ? <Preencher bloco campo="modalidades" /> : (
  <section class="secao" id="atendimento" aria-labelledby="atend-titulo">
    <div class="caixa-l">
      <div class="cabeca cabeca--lado">
        <h2 id="atend-titulo" data-titulo set:html={enfase(t.atendimento.titulo)} />
        <ul class="chips">
          {presencial && <li><Icone nome="mapa" tamanho={16} />Presencial{cidadeCurta && ` em ${cidadeCurta}`}</li>}
          {online && <li><Icone nome="video" tamanho={16} />Online para todo o Brasil</li>}
        </ul>
      </div>

      <div class:list={['blocos', !(presencial && online) && 'blocos--um']}>
        {presencial && (
          <article class="cartao-suave bloco">
            <div class="midia"><Foto arquivo={fotoConsultorio} tipo="consultório" alt="Consultório" proporcao="16 / 10" sizes="(min-width: 1024px) 45vw, 100vw" /></div>
            <div class="conteudo">
              <h3>{t.atendimento.presencial.titulo}</h3>
              <dl>
                {temEndereco ? <div><dt><Icone nome="mapa" tamanho={18} />Endereço</dt><dd>{enderecoLinhas.join(', ')}</dd></div> : <Preencher campo="endereco" />}
                {horarios.length > 0 ? <div><dt><Icone nome="relogio" tamanho={18} />Horários</dt><dd>{horarios.map((h: any) => `${h.dias}, ${h.horas}`).join(' · ')}</dd></div> : <Preencher campo="horarios" />}
                {tem(e.acesso) && <div><dt><Icone nome="carro" tamanho={18} />Acesso</dt><dd>{e.acesso}</dd></div>}
              </dl>
              <Mapa id="mapa-atendimento" />
            </div>
          </article>
        )}
        {online && (
          <article class="cartao-suave bloco">
            <div class="midia">
              {fotoOnline ? <Foto arquivo={fotoOnline} tipo="atendimento online" alt="" proporcao="16 / 10" sizes="(min-width: 1024px) 45vw, 100vw" /> : <div class="sem-foto"><Icone nome="video" tamanho={40} /></div>}
            </div>
            <div class="conteudo">
              <h3>{o.titulo}</h3>
              <dl>
                <div><dt><Icone nome="video" tamanho={18} />Como funciona</dt><dd>{o.comoFunciona}{tem(p.plataformaOnline) && ` Plataforma: ${p.plataformaOnline}.`}</dd></div>
                <div><dt><Icone nome="wifi" tamanho={18} />{o.requisitosTitulo}</dt><dd>{o.requisitos.join(', ')}.</dd></div>
              </dl>
              {p.eNutricionista === true
                ? <p class="cadastro"><Icone nome="escudo" tamanho={18} /><span>{o.eNutricionista}</span></p>
                : <Preencher campo="eNutricionista" nota="pendência: o atendimento online exige cadastro no e-Nutricionista (Resolução CFN nº 760/2023)" />}
            </div>
          </article>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 10px; justify-self: end; }
  .chips li { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 8px; border: 1px solid var(--linha-forte); font-size: 0.85rem; font-weight: 550; color: var(--oliva); }
  .chips :global(svg) { color: var(--salvia); }
  .blocos { display: grid; gap: 24px; }
  @media (min-width: 900px) { .blocos { grid-template-columns: 1fr 1fr; } .blocos--um { grid-template-columns: minmax(0, 720px); } }
  .bloco { overflow: hidden; display: flex; flex-direction: column; }
  .midia :global(.foto) { border-radius: 0; }
  .sem-foto { aspect-ratio: 16 / 10; display: grid; place-items: center; background: var(--salvia-clara); color: var(--salvia); }
  .conteudo { display: grid; gap: 20px; align-content: start; padding: 28px clamp(22px, 3vw, 34px) 32px; }
  .conteudo h3 { font-family: var(--serif); font-weight: 560; font-size: 1.75rem; }
  dl { display: grid; gap: 16px; }
  dl > div { display: grid; gap: 4px; padding-bottom: 16px; border-bottom: 1px solid var(--linha); }
  dt { display: flex; align-items: center; gap: 8px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--salvia); }
  dd { margin: 0; font-size: 0.95rem; color: var(--carvao); }
  .cadastro { display: flex; gap: 10px; align-items: flex-start; font-size: 0.82rem; color: var(--texto-suave); }
  .cadastro :global(svg) { flex: none; color: var(--salvia); margin-top: 2px; }
</style>
