---
// Três artigos recentes na página inicial.
import { getCollection } from 'astro:content';
import { t, enfase } from '../lib/site';
import CartaoArtigo from './CartaoArtigo.astro';
import Icone from './Icone.astro';
const artigos = (await getCollection('artigos')).sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf()).slice(0, 3);
---
{artigos.length > 0 && (
  <section class="secao" id="conteudos" aria-labelledby="conteudos-titulo">
    <div class="caixa-l">
      <div class="cabeca cabeca--lado">
        <h2 id="conteudos-titulo" data-titulo set:html={enfase(t.conteudos.titulo)} />
        <p class="todos"><a class="link" href="/conteudos">Ver todos os conteúdos<Icone nome="seta" tamanho={16} /></a></p>
      </div>
      <div class="grade">
        {artigos.map((a) => <CartaoArtigo artigo={a} />)}
      </div>
    </div>
  </section>
)}

<style>
  .todos { justify-self: end; }
  .grade { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); }
</style>
