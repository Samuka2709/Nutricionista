---
// Passo a passo em sequência real, numa faixa escura com bordas curvas.
import { p, t, secoes, tem, enfase } from '../lib/site';
import Icone from './Icone.astro';
const etapas = (t.metodologia.etapas || []).map((e: any, i: number) => ({ ...e, n: String(i + 1).padStart(2, '0') }));
const leve = (t.metodologia.etapas?.[0]?.antes || '').split('. ').filter(Boolean).map((x: string) => x.replace(/\.$/, ''));
const fatos = [
  tem(p.duracaoConsulta) && { icone: 'relogio', titulo: 'Primeira consulta', texto: p.duracaoConsulta },
  tem(p.retornos) && { icone: 'semana', titulo: 'Retornos', texto: 'a cada 30 a 45 dias' },
  tem(p.comunicacaoEntreConsultas) && { icone: 'conversa', titulo: 'Entre as consultas', texto: 'dúvidas pelo WhatsApp' },
].filter(Boolean) as any[];
---
{secoes.metodologia && (
  <section class="secao secao--escura escuro metodo" id="metodologia" aria-labelledby="metodo-titulo" data-metodo>
    <span class="curva curva--topo" aria-hidden="true"></span>
    <div class="caixa-l">
      <div class="cabeca cabeca--lado">
        <h2 id="metodo-titulo" data-titulo set:html={enfase(t.metodologia.titulo)} />
        {fatos.length > 0 && (
          <ul class="fatos">
            {fatos.map((f) => <li><Icone nome={f.icone} tamanho={18} /><span><strong>{f.titulo}</strong>{f.texto}</span></li>)}
          </ul>
        )}
      </div>
      <ol class="passos tablist">
        {etapas.map((e: any) => (
          <li class="passo aba">
            <span class="num" aria-hidden="true">{e.n}</span>
            <h3><span class="so-leitor">Etapa {Number(e.n)}: </span>{e.titulo}</h3>
            <p>{e.resumo}</p>
          </li>
        ))}
      </ol>
      {leve.length > 0 && (
        <div class="levar">
          <h3>O que levar na primeira consulta</h3>
          <ul>{leve.map((x: string) => <li><Icone nome="check" tamanho={16} />{x}</li>)}</ul>
        </div>
      )}
    </div>
    <span class="curva curva--base" aria-hidden="true"></span>
  </section>
)}

<style>
  .fatos { display: grid; gap: 10px; justify-self: end; }
  .fatos li { display: flex; align-items: center; gap: 12px; font-size: 0.9rem; }
  .fatos :global(svg) { flex: none; color: var(--cobre-claro); }
  .fatos strong { color: var(--creme); font-weight: 650; margin-right: 6px; }

  .passos { position: relative; display: grid; gap: 34px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); counter-reset: none; }
  .passo { position: relative; display: grid; gap: 10px; align-content: start; padding-top: 26px; border-top: 1px solid color-mix(in srgb, var(--creme) 22%, transparent); }
  .passo::before { content: ''; position: absolute; top: -5px; left: 0; width: 9px; height: 9px; border-radius: 2px; background: var(--cobre-claro); }
  .num { font-family: var(--serif); font-size: 2.6rem; font-weight: 500; line-height: 1; color: var(--cobre-claro); }
  .passo h3 { font-family: var(--serif); font-weight: 560; font-size: 1.45rem; }
  .passo p { font-size: 0.95rem; color: var(--sobre-oliva); }

  .levar {
    margin-top: clamp(48px, 6vw, 72px); display: grid; gap: 18px; padding: 28px clamp(22px, 4vw, 40px);
    border-radius: var(--raio); background: color-mix(in srgb, var(--creme) 7%, transparent); border: 1px solid color-mix(in srgb, var(--creme) 14%, transparent);
  }
  .levar h3 { font-size: 1rem; font-weight: 700; color: var(--creme); }
  .levar ul { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .levar li { display: flex; align-items: center; gap: 10px; font-size: 0.92rem; }
  .levar :global(svg) { color: var(--cobre-claro); flex: none; }
  .curva { background: var(--creme); }
</style>
