---
// Retrato em arco, texto em primeira pessoa, credenciais e trajetória; fecha com a frase de filosofia em destaque.
import { p, t, nome, crn, cidadeCurta, online, presencial, especialidades, trajetoria, credenciais, secoes, tem } from '../lib/site';
import Foto from './Foto.astro';
import Icone from './Icone.astro';
import Preencher from './Preencher.astro';

const lista = (itens: string[]) => itens.length <= 1 ? itens.join('') : `${itens.slice(0, -1).join(', ')} e ${itens[itens.length - 1]}`;
const escritos: string[] = (p.sobre?.paragrafos || []).filter(tem);
const rascunho = [
  `Sou nutricionista${crn ? ` (${crn})` : ''}.${presencial && cidadeCurta ? ` Atendo em ${cidadeCurta}${online ? ' e também online' : ''}.` : online ? ' Atendo online.' : ''}${tem(p.publico) ? ` Trabalho com ${p.publico}.` : ''}`,
  especialidades.length ? `No dia a dia, atuo com ${lista(especialidades.map((e) => e.titulo.toLowerCase()))}.` : '',
].filter(Boolean);
const paragrafos = escritos.length ? escritos : rascunho;
const revisado = escritos.length > 0 && p.sobre?.revisado === true;
const linha = [...trajetoria].reverse().slice(-4);
const primeiroNome = (nome || '').split(' ')[0];
---
{!secoes.sobre ? <Preencher bloco campo="nome" /> : (
  <section class="secao" id="sobre" aria-labelledby="sobre-titulo">
    <div class="caixa-l grade">
      <div class="retrato">
        <div class="bloco-areia" aria-hidden="true"></div>
        <div class="arco" data-revela>
          <Foto arquivo={p.fotos?.sobre || p.fotos?.retrato} tipo="retrato vertical" alt={p.fotos?.descricaoSobre || `${nome} em atendimento`} preenche sizes="(min-width: 1024px) 34vw, 90vw" />
        </div>
        <svg class="ramo" viewBox="0 0 60 120" width="60" height="120" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
          <path d="M30 118C30 80 28 44 34 4" />
          <path d="M31 96c-10-4-16-12-17-22 9 2 15 10 17 22Z" /><path d="M31 74c9-3 15-11 16-21-9 2-14 10-16 21Z" />
          <path d="M32 52c-9-4-14-11-15-20 8 2 13 9 15 20Z" /><path d="M33 31c8-3 12-10 13-18-8 2-12 9-13 18Z" />
        </svg>
      </div>

      <div class="texto">
        <h2 id="sobre-titulo" data-titulo>{t.sobre.titulo} <em>{primeiroNome}.</em></h2>
        {!revisado && <p><span class="rascunho">Rascunho: revisar com o profissional</span></p>}
        <div class="prosa">{paragrafos.map((par) => <p>{par}</p>)}</div>

        {credenciais.length > 0 && (
          <ul class="selos">
            {credenciais.map((c) => (
              <li><span class="selo-icone"><Icone nome={c.icone} tamanho={18} /></span><span><strong>{c.titulo}</strong>{c.apoio && <small>{c.apoio}</small>}</span></li>
            ))}
          </ul>
        )}

        {linha.length > 0 ? (
          <div class="trajetoria">
            <h3>{t.sobre.trajetoria}</h3>
            <ol>
              {linha.map((x) => <li><span class="ano">{x.ano}</span><span class="oque">{x.titulo}</span></li>)}
            </ol>
          </div>
        ) : <Preencher campo="formacao, especializacoes, experiencias" />}
      </div>
    </div>

    {tem(p.fraseFilosofia) ? (
      <blockquote class="caixa-l frase">
        <p class="destaque" data-acende>{p.fraseFilosofia}</p>
        <footer><span class="traco" aria-hidden="true"></span>{nome}</footer>
      </blockquote>
    ) : <Preencher campo="fraseFilosofia" />}
  </section>
)}

<style>
  .grade { display: grid; gap: 64px; align-items: center; }
  .retrato { position: relative; width: min(100%, 440px); margin-inline: auto; padding: 0 24px 24px 0; }
  .bloco-areia { position: absolute; left: -24px; right: 0; top: 18%; bottom: 0; background: var(--areia); border-radius: var(--raio); }
  .arco { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--raio); box-shadow: var(--sombra); background: var(--areia); }
  .arco :global(.foto) { border-radius: 0; }
  .ramo { display: none; }

  .texto { display: grid; gap: 22px; justify-items: start; }
  .prosa { display: grid; gap: 14px; color: var(--texto-suave); }

  .selos { display: grid; gap: 10px; width: 100%; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); margin-top: 6px; }
  .selos li { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border-radius: var(--raio); background: var(--branco); border: 1px solid var(--linha); }
  .selo-icone { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; background: var(--salvia-clara); color: var(--salvia); }
  .selos strong { display: block; font-size: 0.9rem; font-weight: 650; color: var(--oliva); line-height: 1.3; }
  .selos small { display: block; font-size: 0.78rem; color: var(--texto-suave); line-height: 1.4; margin-top: 2px; }

  .trajetoria { width: 100%; margin-top: 10px; }
  .trajetoria h3 { font-size: 0.95rem; font-weight: 700; }
  ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 16px; margin-top: 18px; position: relative; }
  ol::before { content: ''; position: absolute; left: 4px; right: 0; top: 4px; height: 1px; background: var(--linha-forte); }
  ol li { position: relative; display: grid; gap: 4px; padding-top: 22px; }
  ol li::before { content: ''; position: absolute; left: 0; top: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--creme); border: 1.5px solid var(--terra); }
  .ano { font-family: var(--serif); font-size: 1.35rem; color: var(--terra); line-height: 1; }
  .oque { font-size: 0.82rem; line-height: 1.4; color: var(--texto-suave); }

  .frase { margin-top: clamp(80px, 10vw, 140px); display: grid; gap: 18px; }
  .destaque {
    font-family: var(--serif); font-weight: 500; font-size: var(--destaque); line-height: 1.08; letter-spacing: -0.02em;
    color: var(--oliva); max-width: 20ch; text-wrap: balance;
  }
  .frase footer { display: flex; align-items: center; gap: 14px; font-size: 0.9rem; color: var(--texto-suave); }
  .traco { width: 32px; height: 1px; background: var(--terra); }

  @media (min-width: 1024px) {
    .grade { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(56px, 7vw, 112px); }
    .retrato { margin: 0; }
  }
</style>
