---
import '../styles/global.css';
import fonteUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Rodape from '../components/Rodape.astro';
import Icone from '../components/Icone.astro';
import { demo, p, tituloSite, descricaoSite, whatsappUrl, nome } from '../lib/site';

interface Props {
  titulo?: string;
  descricao?: string;
  tipo?: 'website' | 'article';
  jsonld?: object[];
  noindex?: boolean;
  inicio?: boolean;
}
const { titulo, descricao = descricaoSite, tipo = 'website', jsonld = [], noindex = false, inicio = false } = Astro.props;
const tituloPagina = titulo ? `${titulo} | ${nome || 'Nutricionista'}` : tituloSite;
const canonica = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const fontes = `@font-face{font-family:"Bricolage Grotesque";font-style:normal;font-display:swap;font-weight:200 800;font-stretch:75% 100%;src:url(${fonteUrl}) format("woff2-variations");}`;
const cabeca = `(function(){var d=document.documentElement;d.classList.add('js');try{if(new URLSearchParams(location.search).has('preview'))d.classList.add('preview');}catch(e){}if(d.hasAttribute('data-inicio')&&!matchMedia('(prefers-reduced-motion: reduce)').matches){d.classList.add('intro');window.__introFalha=setTimeout(function(){d.classList.remove('intro')},3000);}})();`;
---
<!doctype html>
<html lang="pt-BR" data-inicio={inicio ? '' : undefined} data-demo={demo ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {(noindex || demo) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F2F4F0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fonteUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontes}></style>
    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline set:html={cabeca}></script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    {demo && <p class="demo-aviso">Demonstração com dados fictícios<span>: nome, CRN, cadastros, formação e contatos são exemplos, não um profissional real.</span></p>}
    <Header inicio={inicio} />
    <div class="folha">
      <div class="pauta" aria-hidden="true">
        <span class="margem" data-pauta></span>
        {[1, 2, 3, 4, 5, 6].map((n) => <span style={`--n:${n}`} data-pauta></span>)}
      </div>
      <main id="conteudo" tabindex="-1">
        <slot />
      </main>
      <Rodape />
    </div>
    {p.botaoFlutuanteWhatsapp && whatsappUrl && (
      <a class="flutuante" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-flutuante>
        <Icone nome="conversa" tamanho={22} />
        <span class="so-leitor">Falar pelo WhatsApp (abre em nova aba)</span>
      </a>
    )}
    <script>
      import '../scripts/ui';
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
  .flutuante {
    position: fixed; right: 16px; bottom: 16px; z-index: 60;
    display: grid; place-items: center; width: 48px; height: 48px;
    border-radius: var(--raio-botao);
    background: var(--verde); color: var(--papel);
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), visibility 0s linear 200ms;
  }
  :global(.flutuante.visivel) { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .flutuante:active { transform: scale(0.97); }
  @media (prefers-reduced-motion: reduce) { .flutuante { transform: none; } }
</style>
