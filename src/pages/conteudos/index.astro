---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CartaoArtigo from '../../components/CartaoArtigo.astro';
import { CATEGORIAS } from '../../lib/categorias';
import { t, slug } from '../../lib/site';
const artigos = (await getCollection('artigos')).sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
---
<Base titulo="Conteúdos" descricao={`${t.conteudos.titulo} ${t.conteudos.apoio}`}>
  <section class="secao pagina" aria-labelledby="lista-titulo">
    <div class="sem cabeca">
      <div class="v" style="--i:1;--f:5">
        <h1 id="lista-titulo">{t.conteudos.titulo}</h1>
        <p class="apoio">{t.conteudos.apoio}</p>
      </div>
    </div>
    <div class="fio"></div>
    <div class="sem">
      <nav class="v filtro" style="--i:1;--f:7" aria-label="Filtrar por categoria" data-filtro>
        <ul>
          <li><a href="/conteudos" data-cat="" aria-current="true">Todos</a></li>
          {CATEGORIAS.map((c) => <li><a href={`/conteudos?categoria=${slug(c)}`} data-cat={slug(c)}>{c}</a></li>)}
        </ul>
      </nav>
      <div class="v grade" style="--i:1;--f:7" data-lista-artigos>
        {artigos.map((a, i) => <CartaoArtigo artigo={a} variante="grade" semente={i} nivel="h2" />)}
      </div>
      <p class="v vazio" style="--i:1;--f:7" data-vazio-artigos hidden role="status">Ainda não há artigos nesta categoria. <a href="/conteudos" data-cat="">Ver todos os conteúdos</a></p>
    </div>
  </section>
</Base>

<style>
  .pagina { padding-top: calc(var(--header-h) + 56px); }
  h1 { font-size: var(--h2); line-height: 1.05; max-width: 22ch; }
  .cabeca { margin-bottom: 40px; }
  .filtro ul { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtro a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px;
    border: 1.5px solid var(--pauta-forte); border-radius: var(--raio-botao);
    font-size: var(--pequeno); font-weight: 600; color: var(--tinta); text-decoration: none;
    transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;
  }
  .filtro a[aria-current="true"] { background: var(--tinta); border-color: var(--tinta); color: var(--papel); }
  @media (hover: hover) and (pointer: fine) { .filtro a:not([aria-current="true"]):hover { border-color: var(--tinta); } }
  .grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 48px 32px; margin-top: 40px; }
  .grade :global([hidden]) { display: none; }
  .vazio { margin-top: 40px; max-width: none; }
</style>
